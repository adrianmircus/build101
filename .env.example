ANTHROPIC_API_KEY=
SESSION_SECRET=
# Voz rioplatense para "Escuchar" (/api/tts). Sin clave, se usa la voz del navegador.
ELEVENLABS_API_KEY=
# Opcionales: por defecto Tomás (QK4xDwo9ESPHA4JNUpX3) con eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# Origen público de la landing (metadatos, imagen para compartir y WhatsApp). Por defecto: https://usetiza.app
NEXT_PUBLIC_SITE_URL=

# Opcionales: Upstash Redis (integración de Vercel) para que el límite de intentos del login sea compartido entre
# instancias. Sin ellas, el límite se cuenta en la memoria de cada instancia.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Supabase (base de datos y cuentas). En local salen de `npm run db:start` (o `npx supabase status`):
# URL = API_URL, la clave pública = PUBLISHABLE_KEY y la secreta = SECRET_KEY. Los tests de
# integración las leen solos de ahí si no las definís.
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (sb_publishable_...): puede ir al navegador. Con RLS y sin privilegios, solo abre lo que una migración conceda.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...): salta la RLS. Solo servidor, nunca con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SECRET_KEY=

# Fase 2 · cuentas reales
# Secreto del límite de intentos (>= 32 caracteres aleatorios, por ejemplo `openssl rand -hex 32`). Las claves de
# app.rate_limits son un HMAC con este secreto, así nunca guardan una IP, un correo ni un usuario. Solo servidor.
RATE_LIMIT_SECRET=
# Quién manda los correos de invitación: `resend` (producción y staging) o `mailpit` (local y pruebas, API HTTP en
# el puerto 54324 de Supabase local). En producción, sin RESEND_API_KEY la app no arranca.
MAIL_DRIVER=mailpit
# Clave de Resend. Solo servidor.
RESEND_API_KEY=
# Remitente de los correos, por ejemplo: Tiza <no-responder@usetiza.app>. Tiene que ser de un dominio verificado en Resend.
MAIL_FROM=
